# SmartCura Patient App - Environment Configuration
# Copy this file to .env and fill in your actual values

# API Configuration
API_BASE_URL=https://api.smartcura.com
API_KEY=your_api_key_here
API_TIMEOUT=30000

# Jitsi Meet Configuration
JITSI_SERVER_URL=https://meet.jit.si
JITSI_APP_ID=your_jitsi_app_id

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_STORAGE_BUCKET=your_storage_bucket

# Stripe Payment Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# OpenAI Configuration (for AI features)
OPENAI_API_KEY=sk-your_openai_key
OPENAI_MODEL=gpt-4

# Google Maps API (for emergency location)
GOOGLE_MAPS_API_KEY=your_google_maps_key

# App Configuration
APP_NAME=SmartCura
APP_VERSION=1.0.0
ENVIRONMENT=development

# Feature Flags
ENABLE_IOT_FEATURES=false
ENABLE_AI_FEATURES=false
ENABLE_EMERGENCY_SOS=true
ENABLE_BIOMETRIC_AUTH=true

# Debug Settings
DEBUG_MODE=true
LOG_LEVEL=debug
