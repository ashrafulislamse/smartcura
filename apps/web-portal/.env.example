# Browser-visible portal configuration only.
# NEXT_PUBLIC_* values are bundled into client code and are never secrets.
# Do not put any credentials, keys or tokens in this file.
NEXT_PUBLIC_APP_NAME=SmartCura Web Portal
NEXT_PUBLIC_APP_URL=http://localhost:4000

# Base path the portal uses for the SmartCura API.
# Keep this RELATIVE so the portal stays same-origin with the API: the
# `__Host-smartcura_session` cookie the backend sets requires Path=/, Secure and no
# Domain attribute, so a cross-origin API base would break session authentication.
# Next.js proxies /api/v1/* to SMARTCURA_API_ORIGIN (see next.config.js).
NEXT_PUBLIC_API_URL=/api/v1

# Server-side only (not exposed to the browser): the backend origin that
# /api/v1/* is proxied to. Run the portal on a different port than the API,
# for example `next dev -p 4000` while the API listens on 3000.
SMARTCURA_API_ORIGIN=http://localhost:3000

# Identity provider
# No identity provider SDK is installed or configured in this repository. Sign-in and
# step-up verification require an IdentityProvider implementation to be registered via
# configureIdentityProvider() in src/lib/identity/identity-provider.ts. Any provider
# configuration values belong here as NEXT_PUBLIC_* only if they are public by design.

# DEVELOPMENT ONLY. Setting this registers a fixture identity provider that accepts
# any credentials and returns this exact token, which the backend's `local` identity
# adapter is configured to accept. It performs no authentication and exists solely to
# exercise the session flow in a browser. Leave it UNSET in any deployed environment.
# The value is not a secret: it is a non-production fixture, and the backend refuses
# to run the `local` adapter outside development. A warning banner is shown while set.
# NEXT_PUBLIC_DEV_IDENTITY_TOKEN=local-fixture-token-not-for-production

# Server secrets (DATABASE_URL, admin service credentials, JWT signing keys,
# model API keys, SMTP credentials) never belong to the portal. They live in the
# API/worker secret storage.
