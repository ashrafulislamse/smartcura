/*
 * SmartCura vitals monitor - secrets template.
 *
 * Copy this file to `secrets.h` (next to smartcura_vitals_monitor.ino) and fill
 * in your real values. `secrets.h` is in the .gitignore so it is never
 * committed.
 *
 * The .ino reads every value from this file. If `secrets.h` is missing, the
 * build fails with a clear error pointing you at this template.
 */

#ifndef SMARTCURA_SECRETS_H
#define SMARTCURA_SECRETS_H

// --- WiFi -----------------------------------------------------------------
// Your home/office WiFi network. The ESP32 will only connect to 2.4 GHz SSIDs.
#define WIFI_SSID       "YOUR_WIFI_SSID"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"

// --- MQTT broker ----------------------------------------------------------
// The Coolify deployment exposes the Mosquitto broker on the public side only
// via WebSockets on port 9001 (plain MQTT on 1883 is not reachable from the
// device). The .ino talks MQTT-over-WebSocket through the MqttWsClient adapter
// (see line 73 of the .ino); the PORT value below is the WebSocket port.
#define MQTT_HOST       "mqtt.smartcura.app"
#define MQTT_PORT       9001

// --- Device identity ------------------------------------------------------
// device_id MUST be the UUIDv7 returned by POST /organizations/{org_id}/devices
// at provisioning. The MQTT username must equal the device_id (the broker
// enforces this and the server re-proves it from the topic).
//
// The password is the provisioning secret returned alongside the device_id at
// provisioning - keep it out of source control and out of any chat transcript.
#define DEVICE_ID       "00000000-0000-7000-8000-000000000000"
#define MQTT_USERNAME   DEVICE_ID
#define MQTT_PASSWORD   "YOUR_PROVISIONING_SECRET"

// --- Provisioning PIN ------------------------------------------------------
// 8-digit PIN burned at factory flash time. It is printed on the device sticker
// and verified by the SmartCura app over an encrypted BLE session before Wi-Fi
// credentials are sent. It is NOT the MQTT password and must not be shared with
// the patient app over the internet.
#define PROVISIONING_PIN "00000000"

// --- Time zone -------------------------------------------------------------
// Minutes east of UTC. Malaysia is +480 (UTC+8). Bangladesh is +360. UTC is 0.
#define TZ_OFFSET_MIN   480

// --- Offline mode ---------------------------------------------------------
// Set to 1 to disable WiFi, NTP, MQTT and OTA. Useful for bench-testing
// sensors without provisioning credentials or a network.
#define DISABLE_NETWORK 0

#endif // SMARTCURA_SECRETS_H
