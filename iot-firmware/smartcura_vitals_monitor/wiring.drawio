<mxfile host="app.diagrams.net" modified="2026-08-12T14:50:00.000Z" agent="SmartCura" version="24.7.17" type="device">
  <diagram name="Breadboard" id="smartcura-vitals-breadboard">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="SmartCura vitals monitor &#8212; breadboard wiring&#10;ESP32 + MAX30102 (SpO2/HR) + DS18B20 (temp) + 0.91&quot; OLED &#8212; ONE STEP AT A TIME" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1620" height="50" as="geometry" />
        </mxCell>

        <mxCell id="step1" value="STEP 1&#10;Power rails&#10;(red +3.3V, blue GND)&#10;Verify: voltmeter reads +3.3V on red rail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="STEP 2&#10;OLED (0.91&quot;) on I2C&#10;SDA=GPIO21, SCL=GPIO22&#10;Verify: serial says &#8220;[OK] OLED detected&#8221;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="90" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="STEP 3&#10;MAX30102 on I2C (shared bus)&#10;SDA=GPIO21, SCL=GPIO22&#10;Verify: serial says &#8220;[OK] MAX30102 found&#8221;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="90" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="step4" value="STEP 4&#10;DS18B20 on GPIO5&#10;DATA needs 4.7k pull-up to +3.3V&#10;Verify: serial says &#8220;[OK] DS18B20 found&#8221;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="90" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="step5" value="STEP 5&#10;Mount the ESP32 across the center gap, pins facing inward." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;dashed=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="90" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="bb" value="" style="shape=mxgraph.cabinets.breadboard;html=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#444444;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="1620" height="780" as="geometry" />
        </mxCell>

        <mxCell id="rail_pos" value="+3.3V rail (RED)&#10;long red strip along TOP of breadboard" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rail_neg" value="GND rail (BLUE)&#10;long blue strip along BOTTOM of breadboard" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="920" width="200" height="40" as="geometry" />
        </mxCell>

