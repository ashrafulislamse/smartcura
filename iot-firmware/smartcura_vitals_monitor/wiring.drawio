          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="WIRE COLOUR KEY&#10;&#10;Red &#8212; +3.3V power (rail top)&#10;Black &#8212; GND (rail bottom)&#10;Purple &#8212; I2C SDA/SCL&#10;Orange &#8212; 1-Wire DATA (needs pull-up)&#10;Yellow dashes &#8212; pull-up resistor leg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="780" height="80" as="geometry" />
        </mxCell>
        <mxCell id="warn" value="! WARNINGS !&#10;MAX30102 VIN MUST be 3.3V, NOT 5V &#8212; 5V will damage it.&#10;DS18B20 MUST have the 4.7k&#8486; pull-up to +3.3V on its DATA pin, or the firmware says &#8220;not found&#8221;.&#10;OLED and MAX30102 share the same SDA/SCL pair (GPIO21/22). They have different I2C addresses (0x3C and 0x57) so they do not conflict." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#b85450;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="1000" width="820" height="80" as="geometry" />
        </mxCell>

        <mxCell id="verify" value="EXPECTED SERIAL OUTPUT (after each step)&#10;&#10;After STEP 2: [OK] OLED detected.&#10;After STEP 3: [OK] MAX30102 found!  (and later: heartRate / spo2 numbers when a finger is on the sensor)&#10;After STEP 4: [OK] DS18B20 found!  (and later: a temperature in &deg;C every 5 s)&#10;MQTT: a CONNACK byte pair 20 00 (success). 20 02 means &#8220;identifier rejected&#8221; &#8212; the broker has no matching username/password in passwd." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1090" width="1620" height="10" as="geometry" />
        </mxCell>
